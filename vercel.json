{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {"source": "/seminar", "destination": "https://practicetransitionsinstitute.com/events/practice-transition-seminar", "permanent": true},
    {"source": "/seminar/", "destination": "https://practicetransitionsinstitute.com/events/practice-transition-seminar", "permanent": true},
    {"source": "/dr-njo", "destination": "https://practicetransitionsinstitute.com/drnjo", "permanent": true},
    {"source": "/dr-njo/", "destination": "https://practicetransitionsinstitute.com/drnjo", "permanent": true},
    {"source": "/meet-our-team", "destination": "https://practicetransitionsinstitute.com/about", "permanent": true},
    {"source": "/meet-our-team/", "destination": "https://practicetransitionsinstitute.com/about", "permanent": true},
    {"source": "/speaking-engagements", "destination": "https://practicetransitionsinstitute.com/events", "permanent": true},
    {"source": "/speaking-engagements/", "destination": "https://practicetransitionsinstitute.com/events", "permanent": true},
    {"source": "/podcasts", "destination": "https://practicetransitionsinstitute.com/resources/navigating-dental-insurance-podcast", "permanent": true},
    {"source": "/podcasts/", "destination": "https://practicetransitionsinstitute.com/resources/navigating-dental-insurance-podcast", "permanent": true},
    {"source": "/client-testimonials", "destination": "https://practicetransitionsinstitute.com/testimonials", "permanent": true},
    {"source": "/client-testimonials/", "destination": "https://practicetransitionsinstitute.com/testimonials", "permanent": true},
    {"source": "/contact-us", "destination": "https://practicetransitionsinstitute.com/contact", "permanent": true},
    {"source": "/contact-us/", "destination": "https://practicetransitionsinstitute.com/contact", "permanent": true},
    {"source": "/updates/:splat", "destination": "https://practicetransitionsinstitute.com/blog/:splat", "permanent": true},
    {"source": "/updates/:splat/", "destination": "https://practicetransitionsinstitute.com/blog/:splat", "permanent": true},
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.practicetransitionsinstitute.com"
        }
      ],
      "destination": "https://practicetransitionsinstitute.com/:path*",
      "permanent": true
    }
  ]
}
